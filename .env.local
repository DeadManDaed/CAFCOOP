CONFIGURATION SUPABASE
# Remplacez ces valeurs par vos véritables credentials Supabase
# Créez un fichier .env.local (copie de ce fichier) avec vos vraies valeurs

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anonyme-ici

# Note : En production sur Vercel, ajoutez ces variables dans :
# Vercel Dashboard > Votre Projet > Settings > Environment Variables
